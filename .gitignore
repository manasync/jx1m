# ==============================================================================
# JX1M / KIEM THE MONOREPO - STANDARD .GITIGNORE
# (Unity Client + .NET / C# Server + Web SDK + Docker)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backups & Local Temporary Folders
# ------------------------------------------------------------------------------
server_backup_*/
*_backup/
*.backup/
*.bak
*.tmp
*~

# ------------------------------------------------------------------------------
# 2. Operating System Files
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Linux
.directory

# ------------------------------------------------------------------------------
# 3. Unity Client (client/src/ & any Unity subprojects)
# ------------------------------------------------------------------------------
# Auto-generated folders by Unity
**/[Ll]ibrary/
**/[Tt]emp/
**/[Oo]bj/
**/[Bb]uild/
**/[Bb]uilds/
**/[Ll]ogs/
**/[Uu]ser[Ss]ettings/
**/[Mm]emoryCaptures/
**/[Rr]ecordings/

# Specific path matching client/src
client/src/Library/
client/src/Temp/
client/src/Obj/
client/src/Build/
client/src/Builds/
client/src/Logs/
client/src/UserSettings/
client/src/MemoryCaptures/
client/src/Recordings/

# Autogenerated Unity solution & project files (Server solution files must be kept!)
client/**/*.csproj
client/**/*.unityproj
client/**/*.sln
client/**/*.gen.csproj
*.unityproj
ExportedObj/
.consulo/

# Unity generated metadata & crash reports
sysinfo.txt
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity Addressables / StreamingAssets cache
**/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
**/[Aa]ssets/[Ss]treamingAssets/aa.meta
**/[Aa]ssets/[Ss]treamingAssets/aa/*

# JetBrains Rider Unity integration
/[Aa]ssets/Plugins/Editor/JetBrains*

# ------------------------------------------------------------------------------
# 4. .NET / C# Build Artifacts (Server & Web)
# ------------------------------------------------------------------------------
# Exclude build outputs (bin/ and obj/ across all frameworks & configs)
**/[Bb]in/
**/[Oo]bj/

# EXCEPT the standalone server runtime environment (server/bin)
!server/bin/
!server/bin/**

# Compiler symbols and debug caches
*.pdb
*.mdb
*.idb
*.ilk
*.exp
*.map
*.ipdb
*.iobj
*.VC.db
*.opendb
*.svd
*.booproj
*.pidb

# NuGet package restore outputs
*.nuget.cache
*.nuget.g.props
*.nuget.g.targets
project.assets.json
project.lock.json
*.nuget.dgspec.json
**/packages/
!**/packages/build/

# ------------------------------------------------------------------------------
# 5. IDEs & Editors (Visual Studio, Rider, VS Code)
# ------------------------------------------------------------------------------
# Visual Studio
.vs/
*.user
*.userprefs
*.suo
*.sln.docstates
*.ide/
.vsidx/

# Rider / JetBrains
.idea/
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# Visual Studio Code (ignore personal workspace files, keep configs)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/

# ------------------------------------------------------------------------------
# 6. Builds & Binary Packages (Unity / Mobile / Desktop outputs)
# ------------------------------------------------------------------------------
*.apk
*.aab
*.app
*.ipa
*.unitypackage
crashlytics-build.properties
.gradle/

# ------------------------------------------------------------------------------
# 7. Logs, Databases & Runtime Output
# ------------------------------------------------------------------------------
*.log
**/log/
**/logs/

# SQLite & local databases (temp/wal files)
*.db-shm
*.db-wal
*.sqlite-shm
*.sqlite-wal

# ------------------------------------------------------------------------------
# 8. Environment, Secrets & Docker Overrides
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
docker-compose.override.yml
*.pfx
*.keystore
*.jks
