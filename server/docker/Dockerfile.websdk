# Stage 1: Build
FROM mcr.microsoft.com/dotnet/sdk:6.0 AS build
WORKDIR /src

COPY server/src/WEB/KiemTheWebSDK/KiemTheWebSDK.csproj server/src/WEB/KiemTheWebSDK/
RUN dotnet restore server/src/WEB/KiemTheWebSDK/KiemTheWebSDK.csproj

COPY server/src/WEB/KiemTheWebSDK/ server/src/WEB/KiemTheWebSDK/
WORKDIR /src/server/src/WEB/KiemTheWebSDK
RUN dotnet publish -c Release -o /app/publish

# Stage 2: Runtime
FROM mcr.microsoft.com/dotnet/aspnet:6.0 AS runtime
WORKDIR /app

RUN mkdir -p /app/data
ENV ASPNETCORE_URLS=http://+:8081
ENV ConnectionStrings__DefaultConnection="Data Source=/app/data/kiemthe_sdk.db"

COPY --from=build /app/publish .

EXPOSE 8081
VOLUME ["/app/data"]

ENTRYPOINT ["dotnet", "KiemTheWebSDK.dll"]
