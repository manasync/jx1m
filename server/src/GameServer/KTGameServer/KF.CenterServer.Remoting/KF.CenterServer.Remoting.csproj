<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>KF.CenterServer.Remoting</AssemblyName>
    <RootNamespace>KF.Remoting</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>false</Deterministic>
    <LangVersion>latest</LangVersion>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tmsk.Contract\Tmsk.Contract.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Runtime.Remoting" />
    <Reference Include="System.Configuration" />
    <Reference Include="System.Data" />
    <Reference Include="System.Transactions" />
    <Reference Include="System.Xml" />
  </ItemGroup>

  <!-- NuGet: để MSBuild tự restore + giải quyết transitive deps -->
  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.19.4" />
    <PackageReference Include="K4os.Compression.LZ4" Version="1.2.6" />
    <PackageReference Include="K4os.Compression.LZ4.Streams" Version="1.2.6" />
    <PackageReference Include="K4os.Hash.xxHash" Version="1.0.6" />
    <PackageReference Include="MySql.Data" Version="8.0.31" />
    <PackageReference Include="Portable.BouncyCastle" Version="1.9.0" />
    <PackageReference Include="System.Buffers" Version="4.5.1" />
    <PackageReference Include="System.Memory" Version="4.5.4" />
    <PackageReference Include="System.Numerics.Vectors" Version="4.5.0" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="5.0.0" />
  </ItemGroup>

  <!-- DLL cục bộ (legacy, không có trên NuGet) -->
  <ItemGroup>
    <Reference Include="Tmsk.Tools">
      <HintPath>..\libs\Tmsk.Tools.dll</HintPath>
    </Reference>
    <Reference Include="IBatisNet.Common">
      <HintPath>DBUtility\dlls\IBatisNet.Common.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.Practices.EnterpriseLibrary.Common">
      <HintPath>DBUtility\dlls\Microsoft.Practices.EnterpriseLibrary.Common.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.Practices.EnterpriseLibrary.Data">
      <HintPath>DBUtility\dlls\Microsoft.Practices.EnterpriseLibrary.Data.dll</HintPath>
    </Reference>
    <Reference Include="MySQLDriverCS">
      <HintPath>DBUtility\dlls\MySQLDriverCS.dll</HintPath>
    </Reference>
    <Reference Include="System.Data.SQLite">
      <HintPath>DBUtility\dlls\System.Data.SQLite.DLL</HintPath>
    </Reference>
  </ItemGroup>

  <!-- Native DLL: phải copy ra thư mục output để MySQLDriverCS/SQLite nạp được -->
  <ItemGroup>
    <None Include="DBUtility\dlls\libmysql.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
